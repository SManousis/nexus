# Copy to .env. Replace this development placeholder before starting Compose.
# Generate a strong value, for example: openssl rand -base64 48
JWT_SECRET=asd789213esakldd931dbbd1fdc40b18b2925c67a8b7069436ed5878689480fb71682e4716f11f0

# These values must match in User, Gateway, Product, and Media services.
JWT_ISSUER=user-service
JWT_AUDIENCE=buy-01-api

# Comma-separated exact development origins; omit URL paths and trailing slashes.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Required only with docker-compose.prod.yml. It must match the certificate path
# /etc/letsencrypt/live/${SERVER_NAME}/ on the deployment host.
SERVER_NAME=buy01.example.com

# Nexus Repository Manager (docker-compose.nexus.yml). NEXUS_USER/NEXUS_PASS
# should be the nx-ci-deployer `ci-deploy` service account (Phase 5), used by
# jenkins/nexus-settings.xml and the Jenkinsfile's Nexus/Docker publish stages;
# NEXUS_DOCKER_HOST is the host:port used for `docker login`/push/pull against
# the docker-hosted repo (defaults to localhost:8083 for local use).
NEXUS_USER=ci-deploy
NEXUS_PASS=changeme
NEXUS_DOCKER_HOST=localhost:8083

# Nexus admin account, for admin-only operations (creating repos/roles/users).
NEXUS_ADMIN_USER=admin
NEXUS_ADMIN_PASS=changeme
