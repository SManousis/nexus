<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven settings for building against Nexus (docker-compose.nexus.yml).

  This file's URLs target http://nexus:8081 - the container-network address -
  because its primary consumer is Jenkins (Publish to Nexus stage), which runs
  inside the `jenkins` container, joined to nexus_nexus-network. That only
  resolves for containers on that network; `nexus:8081` will NOT resolve from
  your own machine.

  For local/host-machine ad-hoc testing, use the host-published port instead -
  swap `nexus:8081` for `localhost:8082` in both the mirror URL below and the
  command line:
    ./mvnw -s jenkins/nexus-settings.xml -f product-service/pom.xml clean deploy \
      -DaltReleaseDeploymentRepository=nexus-releases::http://localhost:8082/repository/maven-releases/ \
      -DaltSnapshotDeploymentRepository=nexus-snapshots::http://localhost:8082/repository/maven-snapshots/

  Credentials come from NEXUS_USER/NEXUS_PASS (set in .env, injected as env vars) -
  never hardcode them here. See the "Network reachability" callout in plan.md.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">

  <mirrors>
    <mirror>
      <id>nexus-public</id>
      <mirrorOf>*</mirrorOf>
      <url>http://nexus:8081/repository/maven-public/</url>
    </mirror>
  </mirrors>

  <servers>
    <!-- id must match the mirror's id: anonymous access is disabled on this
         Nexus instance, so reads through maven-public need credentials too. -->
    <server>
      <id>nexus-public</id>
      <username>${env.NEXUS_USER}</username>
      <password>${env.NEXUS_PASS}</password>
    </server>
    <server>
      <id>nexus-releases</id>
      <username>${env.NEXUS_USER}</username>
      <password>${env.NEXUS_PASS}</password>
    </server>
    <server>
      <id>nexus-snapshots</id>
      <username>${env.NEXUS_USER}</username>
      <password>${env.NEXUS_PASS}</password>
    </server>
  </servers>

</settings>
